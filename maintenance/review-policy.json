{
  "schemaVersion": 1,
  "targetRepository": "EliteMay/web-project-guide",
  "repositoryDiscovery": {
    "owner": "EliteMay",
    "mode": "all-accessible-repositories",
    "exclude": ["EliteMay/web-project-guide"],
    "includeArchived": false,
    "otherRepositoriesWriteMode": "read-only"
  },
  "repositoryReviewPriority": [
    "PROJECT_LEARNINGS.md",
    "recent commits and changed files",
    "README, specification, PROJECT_RULES and AGENTS.md",
    "remote diagnostic handoff configuration and recent runtime evidence when safely accessible",
    "work reports and changelog",
    "visual design direction, user feedback or rating, rejected visual candidates and post-build visual review",
    "AI-assisted architecture decisions and available oracle or regression tests",
    "diagnostics design and exported schema when committed",
    "tests and GitHub Actions",
    "storage schema and migration"
  ],
  "visualEvidenceReview": {
    "enabled": true,
    "catalog": "catalog/validated-visual-directions.md",
    "evidenceLevels": [
      "user-validated",
      "task-validated",
      "candidate",
      "rejected"
    ],
    "collect": [
      "project and reference commit or version",
      "current visual direction and previous baseline",
      "explicit user visual feedback or rating when available",
      "relative feedback such as previous version preferred",
      "PROJECT_LEARNINGS visual success or failure",
      "what should be kept, fixed and removed",
      "use when and avoid when",
      "transfer, rebuild and do-not-copy boundaries"
    ],
    "doNotTreatAsUserValidated": [
      "latest main only",
      "CI or Pages success only",
      "assistant or coding-agent self-assessment only",
      "theoretical compliance with design rules only",
      "fewer cards, gradients, shadows or effects only",
      "similarity to another validated project only"
    ],
    "promotionPolicy": {
      "validatedDirectionRequires": "explicit positive user feedback, continued successful use, or comparably strong user-facing evidence",
      "taskValidatedMaySupply": "layout or workflow reference only",
      "candidateMaySupply": "comparison input only; do not call it a success",
      "rejectedMustRetain": "failure reason and root lesson so the same direction is not regenerated as a new idea"
    }
  },
  "ruleHygieneReview": {
    "enabled": true,
    "runWhen": [
      "a meaningful common rule is added or changed",
      "monthly deep review"
    ],
    "checks": [
      "duplicate normative guidance across owner documents",
      "README or START_HERE repeating detailed rules instead of routing",
      "orphan numbered docs not reachable from README",
      "new owner docs not reachable from the relevant START_HERE route",
      "full completion checklists duplicated outside templates/QUALITY_CHECKLIST.md",
      "project-specific knowledge stored as common rules instead of PROJECT_LEARNINGS or project rules",
      "catalog evidence promoted to universal rules without reuse evidence",
      "stale version-specific examples or obsolete rules",
      "rule strength that should be lowered to conditional or project-specific scope"
    ],
    "placementOrder": [
      "merge into an existing normative owner when possible",
      "project-specific PROJECT_LEARNINGS or project rules",
      "failure, success, anti-pattern or visual evidence catalog",
      "quality checklist or template",
      "new common rule only when the previous locations are insufficient"
    ],
    "singleNormativeOwner": true,
    "newChapterRequiresDistinctResponsibility": true,
    "ruleAdditionMustCheckConsolidation": true
  },
  "webSources": [
    {
      "name": "W3C Web Accessibility Initiative",
      "url": "https://www.w3.org/WAI/",
      "topics": ["accessibility", "WCAG"]
    },
    {
      "name": "W3C Internationalization",
      "url": "https://www.w3.org/International/",
      "topics": ["language", "internationalization", "RTL"]
    },
    {
      "name": "MDN Web Docs",
      "url": "https://developer.mozilla.org/",
      "topics": ["HTML", "CSS", "JavaScript", "Web APIs", "security", "compatibility", "diagnostics", "performance"]
    },
    {
      "name": "web.dev",
      "url": "https://web.dev/",
      "topics": ["performance", "Core Web Vitals", "responsive", "reliability"]
    },
    {
      "name": "OWASP Cheat Sheet Series",
      "url": "https://cheatsheetseries.owasp.org/",
      "topics": ["web security", "storage", "XSS", "third-party code", "logging"]
    },
    {
      "name": "GitHub Docs",
      "url": "https://docs.github.com/",
      "topics": ["GitHub Pages", "Actions", "repository management", "security", "billing"]
    },
    {
      "name": "Supabase Documentation",
      "url": "https://supabase.com/docs/",
      "topics": ["database", "RLS", "Data API security", "project pausing", "diagnostics backend"]
    },
    {
      "name": "Supabase Pricing",
      "url": "https://supabase.com/pricing",
      "topics": ["free plan", "database quota", "egress", "storage", "active projects"]
    },
    {
      "name": "GitHub Primer",
      "url": "https://primer.style/product/",
      "topics": ["visual design", "layout", "typography", "navigation", "design systems", "accessibility"]
    },
    {
      "name": "Anthropic Frontend Design Skill",
      "url": "https://github.com/anthropics/claude-plugins-official/blob/main/plugins/frontend-design/skills/frontend-design/SKILL.md",
      "topics": ["AI frontend design", "design critique", "copy", "differentiation"]
    },
    {
