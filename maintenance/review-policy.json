      "topics": ["visual review", "design quality", "review severity"]
    },
    {
      "name": "Microsoft Fluent 2",
      "url": "https://fluent2.microsoft.design/",
      "topics": ["visual design", "layout", "spacing", "typography", "design tokens", "components"]
    },
    {
      "name": "Apple Human Interface Guidelines",
      "url": "https://developer.apple.com/design/human-interface-guidelines/",
      "topics": ["design principles", "hierarchy", "layout", "typography", "platform design"]
    },
    {
      "name": "Google Search Central",
      "url": "https://developers.google.com/search/docs",
      "topics": ["public content", "metadata", "SEO"]
    },
    {
      "name": "AGENTS.md",
      "url": "https://agents.md/",
      "topics": ["coding agents", "project instructions", "nested instructions"]
    },
    {
      "name": "Electron Documentation",
      "url": "https://www.electronjs.org/docs/latest/",
      "topics": ["Electron", "security", "packaging", "updates", "logging"]
    },
    {
      "name": "WHATWG HTML Living Standard",
      "url": "https://html.spec.whatwg.org/",
      "topics": ["HTML platform behavior"]
    }
  ],
  "discoveryReferences": [
    {
      "name": "Front-End Checklist",
      "url": "https://github.com/thedaviddias/Front-End-Checklist"
    },
    {
      "name": "Front-End Design Checklist",
      "url": "https://github.com/thedaviddias/Front-End-Design-Checklist"
    }
  ],
  "reviewCadence": {
    "repositoryDeltaReview": "weekly",
    "webStandardsDeltaReview": "weekly",
    "ruleHygieneReview": "on-rule-change",
    "deepReview": "monthly"
  },
  "changePolicy": {
    "lowRiskGuideChange": "may-update-directly-after-validation",
    "highImpactRuleChange": "proposal-or-branch-review",
    "highImpactExamples": [
      "MUST rule added or removed",
      "priority order changed",
      "governance changed",
      "existing project compatibility policy changed",
      "default deployment or storage strategy changed",
      "fixed visual style or layout imposed across projects",
      "paid dependency made mandatory"
    ],
    "requireAuthoritativeSourceForGeneralWebRule": true,
    "requireConcreteEvidenceForProjectDerivedRule": true,
    "noChangeNoCommit": true
  }
}
