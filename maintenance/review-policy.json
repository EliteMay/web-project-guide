{
  "schemaVersion": 1,
  "targetRepository": "EliteMay/web-project-guide",
  "repositoryDiscovery": {
    "owner": "EliteMay",
    "mode": "all-accessible-repositories",
    "exclude": ["EliteMay/web-project-guide"],
    "includeArchived": false,
    "otherRepositoriesWriteMode": "read-only"
  },
  "repositoryReviewPriority": [
    "PROJECT_LEARNINGS.md",
    "recent commits and changed files",
    "README, requirements, specification, PROJECT_RULES and AGENTS.md",
    "remote diagnostic handoff configuration and recent runtime evidence when safely accessible",
    "work reports and changelog",
    "visual design direction, user feedback or rating, rejected candidates and post-build review",
    "architecture decisions and available oracle or regression tests",
    "diagnostics design and exported schema when committed",
    "tests and GitHub Actions",
    "storage schema and migration"
  ],
  "visualEvidenceReview": {
    "enabled": true,
    "catalog": "catalog/validated-visual-directions.md",
    "evidenceLevels": ["user-validated", "task-validated", "candidate", "rejected"],
    "collect": [
      "project and reference commit or version",
      "current visual direction and previous baseline",
      "explicit user visual feedback or rating when available",
      "relative feedback such as previous version preferred",
      "PROJECT_LEARNINGS visual success or failure",
      "what should be kept, fixed and removed",
      "use when and avoid when",
      "transfer, rebuild and do-not-copy boundaries"
    ],
    "doNotTreatAsUserValidated": [
      "latest main only",
      "CI or Pages success only",
      "assistant or coding-agent self-assessment only",
      "theoretical compliance with design rules only",
      "fewer cards, gradients, shadows or effects only",
      "similarity to another validated project only"
    ],
    "promotionPolicy": {
      "validatedDirectionRequires": "explicit positive user feedback, continued successful use, or comparably strong user-facing evidence",
      "taskValidatedMaySupply": "layout or workflow reference only",
      "candidateMaySupply": "comparison input only; do not call it a success",
      "rejectedMustRetain": "failure reason and root lesson so the same direction is not regenerated as a new idea"
    }
  },
  "learningCapture": {
    "enabled": true,
    "target": "PROJECT_LEARNINGS.md",
    "mode": "accumulate-recurrence-knowledge",
    "recordWhen": [
      "high-cost or repeated failure",
      "major structural audit finding",
      "successful pattern with future reuse value",
      "guide change that should influence the next audit"
    ],
    "requiredFields": [
      "what happened",
      "root cause",
      "final fix",
      "detection or regression guard",
      "prevention or next-time hint"
    ],
    "doNotUseFor": [
      "every small edit",
      "long work history",
      "release changelog",
      "duplicate common rule prose"
    ],
    "preserveAfterPromotion": true
  },
  "ruleHygieneReview": {
    "enabled": true,
    "runWhen": ["a meaningful common rule is added or changed", "monthly deep review"],
    "checks": [
      "duplicate normative guidance across owner documents",
      "README or START_HERE repeating detailed rules instead of routing",
      "orphan owner docs not reachable from the router",
      "full completion checklists duplicated outside templates/QUALITY_CHECKLIST.md",
      "project-specific knowledge stored as common rules instead of evidence/reference/project learnings",
      "catalog evidence promoted to universal rules without reuse evidence",
      "stale version-specific examples or obsolete rules",
      "rule strength that should be conditional or project-specific",
      "rule move destination updated but source copy left behind"
    ],
    "placementOrder": [
      "merge into an existing normative owner when possible",
      "project-specific PROJECT_LEARNINGS or project rules",
      "failure, success, anti-pattern or visual evidence catalog",
      "non-normative reference",
      "quality checklist or template",
      "new common owner only when previous locations are insufficient"
    ],
    "singleNormativeOwner": true,
    "newChapterRequiresDistinctResponsibility": true,
    "ruleAdditionMustCheckConsolidation": true
  },
  "deepSystemAudit": {
    "enabled": true,
    "procedure": "maintenance/DEEP_SYSTEM_AUDIT.md",
    "owner": "docs/14-continuous-improvement.md",
    "resultDirectory": "maintenance/audits",
    "assumption": "start from a low-confidence hypothesis and require current repository evidence to earn confidence",
    "ownerDiscovery": "maintenance/rule-router.json owners registry",
    "ownerAxes": [
      "coverage",
      "gap coverage",
      "duplication",
      "rule-research separation",
      "decision quality",
      "failure evidence"
    ],
    "scoreScale": {"min": 0, "max": 3},
    "gapTypes": ["rule gap", "research gap", "evidence gap", "structural gap", "repository operation gap"],
    "severities": ["critical", "high", "medium", "low"],
    "actions": ["keep", "clarify", "expand", "move", "merge", "split", "remove", "research", "add evidence", "route fix", "repository fix"],
    "surfaces": [
      "entry and source-of-truth integrity",
      "all normative owners discovered from current router",
      "human and machine routing parity",
      "template and checklist drift",
      "semantic duplication across documents",
      "research gap and evidence freshness",
      "machine-readable schemas and validator coverage",
      "history and project-specific evidence leakage",
      "repository metadata, workflows, branch lifecycle and final-state operations"
    ],
    "requiredRepresentativeCases": [
      "guide deep review",
      "local UI bug",
      "meaningful visual change",
      "existing save and schema migration",
      "game primary flow or completion change",
      "cross-repository GitHub infrastructure change",
      "conversation handoff or stale checkpoint recovery",
      "researchable question"
    ],
    "completionRequires": [
      "critical and high actionable findings resolved or explicitly externally blocked",
      "medium in-scope actionable findings resolved or explicitly evidence-deferred for correctness",
      "low findings classified as fixed, not applicable, external-only or evidence-deferred",
      "known contradictions are not relabeled as good enough",
      "rule preservation checked when moving or consolidating guidance",
      "human-machine routing parity reviewed on representative cases",
      "structural regression guards added where automation is appropriate",
      "PROJECT_LEARNINGS updated for recurrence-value findings",
      "final pull request diff reviewed",
      "pull request head validation checked",
      "post-merge main validation checked"
    ],
    "scoreIsNotCompletionGate": true
  },
  "webSources": [
    {"name": "W3C Web Accessibility Initiative", "url": "https://www.w3.org/WAI/", "topics": ["accessibility", "WCAG"]},
    {"name": "W3C Internationalization", "url": "https://www.w3.org/International/", "topics": ["language", "internationalization", "RTL"]},
    {"name": "MDN Web Docs", "url": "https://developer.mozilla.org/", "topics": ["HTML", "CSS", "JavaScript", "Web APIs", "security", "compatibility", "diagnostics", "performance"]},
    {"name": "web.dev", "url": "https://web.dev/", "topics": ["performance", "Core Web Vitals", "responsive", "reliability"]},
    {"name": "OWASP Cheat Sheet Series", "url": "https://cheatsheetseries.owasp.org/", "topics": ["authentication", "authorization", "session", "CSRF", "CSP", "file upload", "logging", "web security"]},
    {"name": "GitHub Docs", "url": "https://docs.github.com/", "topics": ["GitHub Pages", "Actions", "repository management", "security", "billing"]},
    {"name": "Supabase Documentation", "url": "https://supabase.com/docs/", "topics": ["database", "RLS", "Data API security", "project pausing", "diagnostics backend"]},
    {"name": "Supabase Pricing", "url": "https://supabase.com/pricing", "topics": ["free plan", "database quota", "egress", "storage", "active projects"]},
    {"name": "GitHub Primer", "url": "https://primer.style/product/", "topics": ["visual design", "layout", "typography", "navigation", "design systems", "accessibility"]},
    {"name": "Microsoft Fluent 2", "url": "https://fluent2.microsoft.design/", "topics": ["visual design", "layout", "spacing", "typography", "design tokens", "components"]},
    {"name": "Apple Human Interface Guidelines", "url": "https://developer.apple.com/design/human-interface-guidelines/", "topics": ["design principles", "hierarchy", "layout", "typography", "platform design"]},
    {"name": "Google Search Central", "url": "https://developers.google.com/search/docs", "topics": ["public content", "metadata", "SEO"]},
    {"name": "AGENTS.md", "url": "https://agents.md/", "topics": ["coding agents", "project instructions", "nested instructions"]},
    {"name": "Electron Documentation", "url": "https://www.electronjs.org/docs/latest/", "topics": ["Electron", "security", "packaging", "updates", "logging"]},
    {"name": "WHATWG HTML Living Standard", "url": "https://html.spec.whatwg.org/", "topics": ["HTML platform behavior"]}
  ],
  "discoveryReferences": [
    {"name": "Front-End Checklist", "url": "https://github.com/thedaviddias/Front-End-Checklist"},
    {"name": "Front-End Design Checklist", "url": "https://github.com/thedaviddias/Front-End-Design-Checklist"}
  ],
  "reviewCadence": {
    "repositoryDeltaReview": "weekly",
    "webStandardsDeltaReview": "weekly",
    "ruleHygieneReview": "on-rule-change",
    "deepReview": "monthly"
  },
  "changePolicy": {
    "lowRiskGuideChange": "may-update-directly-after-validation",
    "highImpactRuleChange": "branch-or-pull-request",
    "highImpactExamples": [
      "MUST rule added or removed",
      "priority order changed",
      "governance changed",
      "existing project compatibility policy changed",
      "default deployment or storage strategy changed",
      "new or split normative owner",
      "paid dependency made mandatory"
    ],
    "requireAuthoritativeSourceForGeneralWebRule": true,
    "requireConcreteEvidenceForProjectDerivedRule": true,
    "noChangeNoCommit": true
  }
}
