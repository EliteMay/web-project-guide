{
  "schemaVersion": 1,
  "targetRepository": "EliteMay/web-project-guide",
  "repositoryDiscovery": {
    "owner": "EliteMay",
    "mode": "all-accessible-repositories",
    "exclude": ["EliteMay/web-project-guide"],
    "includeArchived": false,
    "otherRepositoriesWriteMode": "read-only"
  },
  "repositoryReviewPriority": [
    "PROJECT_LEARNINGS.md",
    "recent commits and changed files",
    "README, specification, PROJECT_RULES and AGENTS.md",
    "remote diagnostic handoff configuration and recent runtime evidence when safely accessible",
    "work reports and changelog",
    "visual design direction, post-build visual review, repeated UI patterns and DesignShelf usage",
    "AI-assisted architecture decisions and available oracle or regression tests",
    "diagnostics design and exported schema when committed",
    "tests and GitHub Actions",
    "storage schema and migration"
  ],
  "webSources": [
